# Secrets: never commit
/sudo-creds
.env
!.env.example

# Upstream Perl GADS: separate public clones (see README.md)
/upstream/

# Build output
/gads-go/bin/
/gads-go/gads

# Conformance results: keep only the Perl golden observations and the
# benchmark reports; the rest are regenerated by the run scripts
/conformance/results/*/
!/conformance/results/perl/
!/conformance/results/perl-pg/

# Editor and OS clutter
*.swp
*~
.DS_Store

# Caches
__pycache__/
_Inline/
