# The HTTPS proxy in front of GADS (the proxy service of docker-compose.yml),
# as Perl GADS is deployed behind a TLS web server. Caddy terminates TLS
# for GADS_HOST, redirects HTTP to HTTPS and passes requests to the app,
# which is not published itself.
#
# GADS_TLS chooses the certificate:
#   internal                 Caddy's own CA (the default; for localhost or
#                            an internal server: trust its root certificate)
#   you@example.com          Let's Encrypt, for a public GADS_HOST with
#                            ports 80 and 443 reachable from the internet
#   /certs/cert.pem /certs/key.pem
#                            your own certificate and key, in GADS_CERTS
{
	http_port {$GADS_HTTP_PORT:80}
	https_port {$GADS_HTTPS_PORT:443}
	# No admin API: nothing else needs to change the configuration
	admin off
}

{$GADS_HOST:localhost} {
	tls {$GADS_TLS:internal}

	# Caddy sets X-Forwarded-For (the client address, replacing what the
	# client sent), X-Forwarded-Proto and X-Forwarded-Host, which the app
	# trusts with behind_proxy: 1
	reverse_proxy app:3000 {
		# The app's own request ID is kept; this one names the request in
		# both logs
		header_up X-Request-ID {http.request.uuid}
	}

	# The app sends HSTS in hardened mode; this covers gads: hardened: 0
	header ?Strict-Transport-Security "max-age=31536000"

	# The request line of each request, as JSON on stdout
	log
}
