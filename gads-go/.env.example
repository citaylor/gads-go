# Copy to .env and set the passwords (docker compose reads .env)
POSTGRES_DB=gads
POSTGRES_USER=gads
POSTGRES_PASSWORD=change-me

# The host name the site is reached by (GADS redirects other hosts to it,
# and the proxy's certificate is for it)
GADS_HOST=localhost
# The certificate of the HTTPS proxy: internal (Caddy's own CA; trust its
# root certificate, see GETTING-STARTED.md), an email address (Let's
# Encrypt, for a public GADS_HOST with ports 80 and 443 open), or
# "/certs/cert.pem /certs/key.pem" (your own, in docker/certs or GADS_CERTS)
GADS_TLS=internal
GADS_HTTP_PORT=80
GADS_HTTPS_PORT=443
GADS_INSTANCE_NAME=datasheet
# The first user, given all permissions on first start
GADS_ADMIN_EMAIL=admin@localhost
GADS_ADMIN_PASSWORD=change-me-too

# Emails: the From address, and the SMTP server. With SMTP_HOST empty,
# sendmail is used, which the image does not include (no emails are sent).
GADS_EMAIL_FROM='"Linkspace" <noreply@example.com>'
SMTP_HOST=
# Default 587 (465 with SMTP_SECURITY=tls, 25 with none)
SMTP_PORT=
# starttls (default), tls (implicit TLS) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
