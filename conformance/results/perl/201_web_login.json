 address\"\n    \n  >\n  <label for=\"remember\" id=\"remember-label\" class=\"checkbox-label form-label\">\n    Remember email address\n  </label>\n  \n</div>\n\n\n\n</div>\n\n\n\n<div class=\"form-group mb-4\">\n\n  <div class=\"input input--password\">\n    <div class=\"input__label\">\n  \n  <label for=\"password\" class=\"form-label\">\n    Password\n  </label>\n  \n</div>\n\n\n    <div class=\"input__field\">\n      <input\n        type=\"password\"\n        class=\"form-control \"\n        id=\"password\"\n        name=\"password\"\n        placeholder=\"Password\"\n        value=\"\"\n        autocomplete=\"off\"\n        tabindex=\"3\"\n      >\n\n      <button type=\"button\" class=\"input__reveal-password\">\n        <span> Reveal password </span>\n      </button>\n    </div>\n  </div>\n  <a href=\"/resetpw\" class=\"link\">Reset password</a>\n\n\n\n</div>\n\n\n    </fieldset>\n  </div>\n\n  <div class=\"login__btns\">\n    <button tabindex=\"4\" type=\"submit\" name=\"signin\" value=\"1\" class=\"btn btn-primary\">\n      <span class=\"btn__title\">Sign in</span>\n    </button>\n  </div>\n</form>\n\n\n<div class=\"login__subtext\">\n  <a href=\"/register\">Request an account</a>\n</div>\n\n\n  </div>\n</main>\n\n<footer class=\"login__footer row\">\n  <div class=\"login__footer-container col-md-12\">\n    a product by\n    <img src=\"/images/logo_ctrlo.svg\" class=\"login__footer-logo\">\n  </div>\n</footer>\n\n    </div>\n    <script type=\"text/javascript\" src=\"http://localhost/js/fengari-web.js\"></script>\n    <script type=\"text/javascript\" src=\"http://localhost/js/site.js?v=40\"></script>\n  </body>\n</html>\n",
